"}],"description":"Lighter readonly token. Used only to extract account_index.","title":"Token"},"description":"Lighter readonly token. Used only to extract account_index."},{"name":"account","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Specific Lighter account_index. If set, response is a single number.","title":"Account"},"description":"Specific Lighter account_index. If set, response is a single number."},{"name":"accounts","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Comma-separated Lighter account_index values. Returns a CSV table.","title":"Accounts"},"description":"Comma-separated Lighter account_index values. Returns a CSV table."},{"name":"address","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"L1 wallet address linked to Lighter accounts. Best-effort fallback.","title":"Address"},"description":"L1 wallet address linked to Lighter accounts. Best-effort fallback."},{"name":"field","in":"query","required":false,"schema":{"type":"string","description":"Balance field to return. Default is total_asset_value.","default":"total_asset_value","title":"Field"},"description":"Balance field to return. Default is total_asset_value."}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}},"text/csv":{},"text/plain":{}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/hyperliquid/balance":{"get":{"tags":["hyperliquid"],"summary":"Export Hyperliquid balance for Google Sheets","description":"Returns a CSV table for a Hyperliquid main account and its subaccounts, or a single plain-text number when `account` or `aggregate` is provided.","operationId":"get_hyperliquid_balance_hyperliquid_balance_get","parameters":[{"name":"address","in":"query","required":true,"schema":{"type":"string